# Social links — used throughout the Hero and Footer components
VITE_LINKEDIN_URL=https://linkedin.com/in/yourusername
VITE_GITHUB_URL=https://github.com/yourusername
VITE_FACEBOOK_URL=https://facebook.com/yourusername
VITE_INSTAGRAM_URL=https://instagram.com/yourusername

# Contact details — used in the Contact section
VITE_EMAIL=hello@example.com
VITE_PHONE=+94 77 123 4567

# EmailJS — required for the contact form to actually send messages.
# Create a free account at https://www.emailjs.com/, then add a service,
# an email template, and copy the three values below.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
